# ============================================================================
# Quackback production environment — for docker-compose.prod.yml
# ============================================================================
# Copy to .env (in the repo root, next to docker-compose.prod.yml), fill in
# EVERY value below, then:
#   docker compose -f docker-compose.prod.yml up -d
#
# Rules (Docker reads these literally):
#   - no quotes around values
#   - no inline "# comments" on a value line
#
# You do NOT set DATABASE_URL / REDIS_URL here — the prod compose builds
# those from the secrets below and wires them to the internal services
# automatically. S3_* below IS read directly (Meshfield fork: MinIO removed,
# points at Backblaze B2 instead — see docker-compose.prod.yml).

# --- Application ---------------------------------------------------------
# Public URL of your instance (auth, emails and OAuth callbacks depend on it).
BASE_URL=https://feedback.example.com

# Session signing + encryption key. MUST be >= 32 chars.
# Generate with: openssl rand -base64 32
SECRET_KEY=

# Published image tag to run. Pin to a release (e.g. 0.10.6) in production.
QUACKBACK_TAG=latest

# Host port to publish the app on (the container always listens on 3000).
APP_PORT=3000

# --- PostgreSQL (internal `postgres` service) ----------------------------
POSTGRES_USER=quackback
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=quackback

# --- Object storage (Backblaze B2, S3-compatible) -------------------------
# Meshfield fork: MinIO's container images are no longer freely pullable
# (MinIO Inc. gated them behind a login in 2025), so this fork uses Backblaze
# B2 directly instead of a bundled MinIO service. Use a bucket-scoped
# application key, not the account master key.
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_BUCKET=meshfield-quackback-uploads
S3_REGION=eu-central-003
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Postgres backups (nightly pg_dump -> Backblaze B2) ------------------
# Meshfield fork: separate, dedicated bucket-scoped key (not the S3_* upload
# key above, not the shared meshfield-backups master key) — see
# MESHFIELD-SETUP.md.
PG_BACKUP_SCHEDULE=@daily
PG_BACKUP_KEEP_DAYS=14
PG_BACKUP_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
PG_BACKUP_S3_REGION=eu-central-003
PG_BACKUP_S3_BUCKET=meshfield-backups
PG_BACKUP_S3_PREFIX=quackback
PG_BACKUP_S3_ACCESS_KEY_ID=
PG_BACKUP_S3_SECRET_ACCESS_KEY=

# --- Email (required for invites, magic links, notifications) ------------
# SMTP (works with any provider). Leave blank to log emails to the console.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=Quackback <noreply@example.com>
# Or use Resend instead of SMTP:
# EMAIL_RESEND_API_KEY=

# --- AI (optional) -------------------------------------------------------
# Enables summaries, duplicate detection, feedback extraction, etc.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
